<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>directory-index</ToolCommandName>
    <PackageId>DirectoryIndexToHtml</PackageId>
    <Version>1.0.0</Version>
    <Authors>Andrei Ignat</Authors>
    <Description>Generate transactional directory index HTML pages.</Description>
    <PackageTags>dotnet-tool;directory-index;html</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ignatandrei/DirectoryIndexToHtml</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ignatandrei/DirectoryIndexToHtml</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="11.0.0" />
    <PackageReference Include="Scriban" Version="7.6.1" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DirectoryIndex.Core\DirectoryIndex.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
